{
  "name": "@nirioppai/feature-suggestions",
  "version": "1.2.4",
  "description": "Framework-agnostic feature suggestion widget",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./themes/mui": {
      "types": "./dist/themes/mui.d.ts",
      "import": "./dist/themes/mui.esm.js",
      "require": "./dist/themes/mui.cjs.js"
    },
    "./themes/tailwind": {
      "types": "./dist/themes/tailwind.d.ts",
      "import": "./dist/themes/tailwind.esm.js",
      "require": "./dist/themes/tailwind.cjs.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:consumer",
    "test:unit": "vitest run src",
    "test:consumer": "npm run build && vitest run test/e2e.consumer.test.ts",
    "test:phase6": "npm run build && vitest run src/widget.test.ts src/adapters/firebase.test.ts test/e2e.consumer.test.ts",
    "test:phase7": "npm run build && vitest run src/status.test.ts src/feed.test.ts src/widget.test.ts",
    "test:phase8": "npm run build && vitest run test/e2e.consumer.test.ts && npm pack --dry-run"
  },
  "peerDependencies": {
    "firebase": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "devDependencies": {
    "firebase": "^10.0.0",
    "happy-dom": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
